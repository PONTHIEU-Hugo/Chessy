func main()
{
    i32 tester1 = 5;
    i32 tester2 = 2;

    // Boolean operations
    bool booleans = tester1 == tester2;
    booleans = tester1 != tester2;
    booleans = tester1 < tester2;
    booleans = tester1 <= tester2;
    booleans = tester1 > tester2;
    booleans = tester1 >= tester2;

    booleans = true && true;
    booleans = true && false;
    booleans = false && false;

    booleans = true || true;
    booleans = true || false;
    booleans = false || false;
}